# Local data is downloaded separately and regenerated by Notebooks 1 and 2.
/data/raw/
/data/splits/
/data/preprocessed/*
!/data/preprocessed/README.md

# Keep only the frozen dependencies and compact provenance records.
/artifacts/*
!/artifacts/manifest.json
!/artifacts/reviewed_economical_parameters.json
!/artifacts/test_evaluation_plan.json
!/artifacts/verification.json
!/artifacts/models/
/artifacts/models/*
!/artifacts/models/focused_tuned_models.joblib
!/artifacts/scores/
/artifacts/scores/*
!/artifacts/scores/focused_tuning_scores.npz
!/artifacts/scores/final_test_scores.npz
!/artifacts/final/
/artifacts/final/*
!/artifacts/final/logistic_regression.joblib
!/artifacts/final/neural_network_challenger.joblib
!/artifacts/final/model_policy.json

# Publish aggregate results and the revised presentation only.
/results/historical/
/results/tables/final_test_probabilities.csv
/results/presentation/*
!/results/presentation/Employee_Attrition_Project_Showcase_Revised.pptx

# Notebook checkpoints, local environments, credentials and temporary files.
**/.ipynb_checkpoints/
**/__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
kaggle.json
.kaggle/
.DS_Store
Thumbs.db
~$*
*.tmp
*.log
.github-readiness/
